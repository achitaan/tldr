# Copy to .env.local in the repository root. Values are literal, not shell code.
# Leave AI disabled until you verify a dedicated project's free quota and billing OFF.
GEMINI_API_KEY=
TLDR_GEMINI_MODEL=gemini-3.8-flash
TLDR_FREE_PROJECT_ACK=
TLDR_DATA_TERMS_ACK=
# Optional: install Ollama and pull embeddinggemma separately, then set 1.
TLDR_OLLAMA_EMBEDDINGS=0
# No cloud features are used by the local embedding service.
OLLAMA_NO_CLOUD=1
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
